{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié — TechLink{% endblock %}

{% block body %}
    <section class="max-w-md mx-auto px-6 py-16">
        <h1 class="text-3xl font-bold mb-2">Mot de passe oublié</h1>
        <p class="text-neutral-500 text-sm mb-8">Entre ton email et on t'envoie un lien pour réinitialiser ton mot de passe.</p>

        {% for flash_error in app.flashes('reset_password_error') %}
            <div class="bg-red-500/10 border border-red-500 text-red-500 text-sm rounded-xl px-4 py-3 mb-6">
                {{ flash_error }}
            </div>
        {% endfor %}

        {{ form_start(requestForm, {attr: {class: 'flex flex-col gap-5'}}) }}
            <div>
                {{ form_label(requestForm.email, 'Email', {label_attr: {class: 'block text-sm text-neutral-400 mb-2'}}) }}
                {{ form_widget(requestForm.email, {attr: {class: 'w-full bg-neutral-900 border border-neutral-700 rounded-full px-5 py-2.5 text-sm focus:outline-none focus:border-orange-500'}}) }}
            </div>

            <button type="submit" class="bg-white text-black font-semibold px-6 py-3 rounded-full hover:bg-orange-500 transition w-full">
                Envoyer le lien de réinitialisation
            </button>
        {{ form_end(requestForm) }}

        <p class="text-sm text-neutral-500 mt-6 text-center">
            <a href="{{ path('app_login') }}" class="text-orange-500 hover:underline">Retour à la connexion</a>
        </p>
    </section>
{% endblock %}