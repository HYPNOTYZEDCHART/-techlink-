{% extends 'base.html.twig' %}

{% block title %}Email envoyé — TechLink{% endblock %}

{% block body %}
    <section class="max-w-md mx-auto px-6 py-16 text-center">
        <div class="text-6xl mb-6">📧</div>
        <h1 class="text-2xl font-bold mb-4">Vérifie ta boîte mail</h1>
        <p class="text-neutral-400 text-sm mb-2">
            Si un compte correspond à cet email, un lien de réinitialisation vient d'être envoyé. Ce lien expire dans {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.
        </p>
        <p class="text-neutral-500 text-sm mt-6">
            Tu ne le vois pas ? Vérifie tes spams ou <a href="{{ path('app_forgot_password_request') }}" class="text-orange-500 hover:underline">réessaie</a>.
        </p>
    </section>
{% endblock %}