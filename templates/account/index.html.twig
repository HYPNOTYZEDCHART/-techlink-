{% extends 'base.html.twig' %}

{% block title %}Mon compte — TechLink{% endblock %}

{% block body %}
    <section class="max-w-3xl mx-auto px-6 py-16">
        <h1 class="text-3xl font-bold mb-8">Mon compte</h1>

        <div class="border border-neutral-800 rounded-2xl p-6 mb-6">
            <p class="text-xs text-neutral-500 uppercase tracking-wide mb-4">Informations</p>
            <div class="flex flex-col gap-2 text-sm">
                <p><span class="text-neutral-500">Nom :</span> {{ app.user.firstName }} {{ app.user.lastName }}</p>
                <p><span class="text-neutral-500">Email :</span> {{ app.user.email }}</p>
                {% if app.user.phone %}
                    <p><span class="text-neutral-500">Téléphone :</span> {{ app.user.phone }}</p>
                {% endif %}
            </div>
        </div>

        <a href="{{ path('app_account_orders') }}" class="flex items-center justify-between border border-neutral-800 rounded-2xl p-6 hover:border-orange-500 transition">
            <div>
                <p class="font-semibold">Mes commandes</p>
                <p class="text-neutral-500 text-sm">Voir l'historique et le statut de tes commandes</p>
            </div>
            <span class="text-orange-500">→</span>
        </a>

        <a href="{{ path('app_wishlist') }}" class="flex items-center justify-between border border-neutral-800 rounded-2xl p-6 hover:border-orange-500 transition mt-4">
    <div>
        <p class="font-semibold">Mes favoris</p>
        <p class="text-neutral-500 text-sm">Retrouve les produits que tu as ajoutés à tes favoris</p>
    </div>
    <span class="text-orange-500">→</span>
</a>
    </section>
{% endblock %}