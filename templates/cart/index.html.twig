{% extends 'base.html.twig' %}

{% block title %}Mon panier — TechLink Dakar{% endblock %}

{% block body %}
    <section class="max-w-4xl mx-auto px-4 md:px-6 py-10">
        <div class="flex items-center justify-between mb-8">
            <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight">Mon Panier</h1>
            {% if items is not empty %}
                <span class="text-xs bg-neutral-900 border border-neutral-800 text-neutral-400 px-3 py-1.5 rounded-full font-mono">
                    {{ items|length }} référence{{ items|length > 1 ? 's' : '' }}
                </span>
            {% endif %}
        </div>

        {% for message in app.flashes('success') %}
            <div class="bg-green-500/10 border border-green-500/30 text-green-400 text-xs rounded-xl px-4 py-3 mb-6 flex items-center gap-2">
                <span>✓</span>
                <span>{{ message }}</span>
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="bg-red-500/10 border border-red-500/30 text-red-400 text-xs rounded-xl px-4 py-3 mb-6 flex items-center gap-2">
                <span>⚠️</span>
                <span>{{ message }}</span>
            </div>
        {% endfor %}

        {% if items is empty %}
            <div class="flex flex-col items-center justify-center py-20 px-6 text-center border border-neutral-800/80 rounded-3xl bg-neutral-950">
                <div class="w-16 h-16 rounded-2xl bg-neutral-900 border border-neutral-800 flex items-center justify-center text-3xl mb-4">
                    🛒
                </div>
                <h2 class="text-xl font-bold mb-2 text-white">Votre panier est vide</h2>
                <p class="text-xs text-neutral-400 max-w-sm mb-6 leading-relaxed">
                    Découvrez notre catalogue de laptops, smartphones et accessoires reconditionnés certifiés avec garantie 1 an.
                </p>
                <a 
                    href="{{ path('app_product_index') }}" 
                    class="bg-orange-500 hover:bg-orange-400 text-black text-xs font-extrabold px-6 py-3.5 rounded-xl transition transform active:scale-95 shadow-lg shadow-orange-500/20"
                >
                    Explorer le catalogue
                </a>
            </div>
        {% else %}
            <div class="flex flex-col gap-4 mb-8">
                {% for item in items %}
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border border-neutral-800 bg-neutral-900/40 rounded-2xl p-4 transition hover:border-neutral-700">
                        <div class="flex items-center gap-4">
                            {% if item.product.imageFilename %}
                                <img 
                                    src="{{ asset('images/products/' ~ item.product.imageFilename) }}" 
                                    alt="{{ item.product.name }}" 
                                    class="w-16 h-16 sm:w-20 sm:h-20 rounded-xl object-cover bg-neutral-950 border border-neutral-800"
                                >
                            {% else %}
                                <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-xl bg-neutral-950 border border-neutral-800 flex items-center justify-center text-neutral-600">
                                    📷
                                </div>
                            {% endif %}

                            <div>
                                <a href="{{ path('app_product_show', {slug: item.product.slug}) }}" class="font-bold text-sm text-white hover:text-orange-400 transition">
                                    {{ item.product.name }}
                                </a>
                                {% if item.selectedColor %}
                                    <p class="text-xs text-neutral-400 mt-0.5">Couleur : <span class="text-neutral-200">{{ item.selectedColor }}</span></p>
                                {% endif %}
                                <p class="text-xs font-mono text-orange-400 font-bold mt-1">
                                    {{ item.product.price|number_format(0, ',', ' ') }} XOF
                                </p>
                            </div>
                        </div>

                        <!-- Quantité & Action -->
                        <div class="flex items-center justify-between sm:justify-end gap-4 pt-2 sm:pt-0 border-t sm:border-t-0 border-neutral-800">
                            <form method="post" action="{{ path('app_cart_update', {id: item.id}) }}" class="flex items-center gap-2">
                                <input type="hidden" name="_token" value="{{ csrf_token('cart_update_' ~ item.id) }}">
                                <span class="text-xs text-neutral-500 sm:hidden">Qté:</span>
                                <input
                                    type="number"
                                    name="quantity"
                                    value="{{ item.quantity }}"
                                    min="1"
                                    max="{{ item.product.stock }}"
                                    class="w-14 bg-neutral-950 border border-neutral-700 rounded-lg px-2.5 py-1.5 text-xs text-center font-mono focus:outline-none focus:border-orange-500 text-white"
                                >
                                <button type="submit" class="text-[11px] text-neutral-400 hover:text-white px-2 py-1 bg-neutral-800 rounded-lg transition active:scale-95">
                                    Modifier
                                </button>
                            </form>

                            <div class="text-right pl-2 font-mono text-sm font-bold text-white whitespace-nowrap">
                                {{ (item.product.price * item.quantity)|number_format(0, ',', ' ') }} XOF
                            </div>

                            <form method="post" action="{{ path('app_cart_remove', {id: item.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('cart_remove_' ~ item.id) }}">
                                <button 
                                    type="submit" 
                                    class="text-neutral-500 hover:text-red-400 transition p-2 rounded-lg hover:bg-red-500/10 active:scale-95 text-xs" 
                                    title="Supprimer l'article"
                                >
                                    ✕
                                </button>
                            </form>
                        </div>
                    </div>
                {% endfor %}
            </div>

            <!-- Récapitulatif Total & Checkout CTA -->
            <div class="bg-neutral-900/60 border border-neutral-800 rounded-2xl p-6 flex flex-col sm:flex-row items-center justify-between gap-6 shadow-xl">
                <div>
                    <span class="text-xs text-neutral-400">Total estimé (hors livraison) :</span>
                    <p class="text-2xl font-extrabold text-orange-500 font-mono">
                        {{ total|number_format(0, ',', ' ') }} XOF
                    </p>
                    <p class="text-[11px] text-neutral-500 mt-0.5">Livraison calculée lors de la validation.</p>
                </div>

                <div class="flex items-center gap-3 w-full sm:w-auto">
                    <a 
                        href="{{ path('app_product_index') }}" 
                        class="hidden sm:inline-block text-xs text-neutral-400 hover:text-white transition px-4 py-3"
                    >
                        Poursuivre les achats
                    </a>
                    <a 
                        href="{{ path('app_cart_checkout') }}" 
                        class="w-full sm:w-auto text-center bg-orange-500 hover:bg-orange-400 text-black text-xs font-extrabold px-8 py-3.5 rounded-xl transition transform active:scale-[0.97] shadow-lg shadow-orange-500/20"
                    >
                        Valider la commande →
                    </a>
                </div>
            </div>
        {% endif %}
    </section>
{% endblock %}