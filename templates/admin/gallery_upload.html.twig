{% extends 'base.html.twig' %}

{% block title %}
  Photos — {{ product.name }} — Admin
{% endblock %}

{% block body %}
  <section class="max-w-5xl mx-auto px-6 py-12">
    <h1 class="text-2xl font-bold mb-8">Photos — {{ product.name }}</h1>

    {% for message in app.flashes('success') %}
      <div
        class="bg-green-500/10 border border-green-500 text-green-500 text-sm rounded-xl px-4 py-3 mb-6"
      >
        {{ message }}
      </div>
    {% endfor %}

    <div class="border border-neutral-800 rounded-2xl p-6 mb-8">
      <form
        method="post"
        enctype="multipart/form-data"
        class="flex flex-col gap-4"
      >
        <label
          class="border-2 border-dashed border-neutral-700 rounded-2xl p-8 text-center cursor-pointer hover:border-orange-500 transition block"
        >
          <input
            type="file"
            name="images[]"
            multiple
            accept="image/jpeg,image/png,image/webp"
            class="hidden"
            onchange="this.nextElementSibling.textContent = this.files.length + ' fichier(s) sélectionné(s)'"
          />
          <p class="text-neutral-400 text-sm">
            📁 Clique ici pour choisir une ou plusieurs photos
          </p>
          <p class="text-neutral-600 text-xs mt-1">
            Aucun fichier sélectionné
          </p>
        </label>
        <button
          type="submit"
          class="bg-white text-black font-semibold px-6 py-3 rounded-full hover:bg-orange-500 transition w-fit"
        >
          Uploader les photos
        </button>
      </form>
    </div>

    <div class="grid grid-cols-3 md:grid-cols-6 gap-3">
      {% for image in product.productImages %}
        <div class="rounded-xl overflow-hidden">
          <img
            src="{{ asset('images/products/' ~ image.filename) }}"
            class="w-full h-24 object-cover"
          />
        </div>
      {% endfor %}
    </div>

    <a
      href="{{ path('admin') }}"
      class="inline-block mt-8 text-sm text-orange-500 hover:underline"
    >
      ← Retour au dashboard
    </a>
  </section>
{% endblock %}
