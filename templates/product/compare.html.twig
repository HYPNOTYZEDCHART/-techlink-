{% extends 'base.html.twig' %}

{% block title %}Comparateur Haute Précision — TechLink{% endblock %}

{% block meta_description %}
    Comparez les fiches techniques, processeurs, écrans, mémoires et prix de vos équipements électroniques chez TechLink Dakar.
{% endblock %}

{% block body %}
<section class="max-w-7xl mx-auto px-4 sm:px-6 py-10" data-controller="comparison">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-neutral-400 mb-6 font-mono" aria-label="Fil d'Ariane">
        <a href="{{ path('app_home') }}" class="hover:text-white transition">Accueil</a>
        <span>/</span>
        <a href="{{ path('app_product_index') }}" class="hover:text-white transition">Catalogue</a>
        <span>/</span>
        <span class="text-cyan-400">Comparateur Technique</span>
    </nav>

    <!-- Header Section -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8 pb-6 border-b border-white/10">
        <div>
            <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-mono mb-2">
                <span>⚡</span>
                <span>Matrice Comparative Directe</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-white">Comparateur Haute Précision</h1>
            <p class="text-sm text-neutral-400 mt-1">Confrontez les spécifications matérielles, performances et garanties côte à côte.</p>
        </div>

        {% if products is not empty %}
            <div class="flex items-center gap-3">
                <a
                    href="{{ path('app_product_index') }}"
                    class="px-4 py-2 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-xs font-medium text-neutral-200 transition"
                >
                    + Ajouter un produit
                </a>
                <button
                    type="button"
                    data-action="click->comparison#clear"
                    class="px-4 py-2 rounded-xl bg-red-500/10 hover:bg-red-500/20 border border-red-500/30 text-xs font-medium text-red-400 transition"
                >
                    Vider la matrice
                </button>
            </div>
        {% endif %}
    </div>

    {% if products is empty %}
        <!-- Empty State -->
        <div class="py-20 px-6 rounded-3xl bg-[#0D0F17] border border-white/10 text-center max-w-2xl mx-auto shadow-2xl">
            <div class="w-16 h-16 rounded-2xl bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 flex items-center justify-center mx-auto mb-4 text-2xl">
                ⚖
            </div>
            <h2 class="text-xl font-bold text-white mb-2">Aucun produit dans le comparateur</h2>
            <p class="text-sm text-neutral-400 mb-8 max-w-md mx-auto">
                Ajoutez jusqu'à 3 ordinateurs ou smartphones depuis le catalogue pour comparer instantanément leurs processeurs, mémoires vives, dalles d'affichage et prix.
            </p>
            <a
                href="{{ path('app_product_index') }}"
                class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-black font-semibold text-sm transition shadow-[0_0_25px_rgba(6,182,212,0.35)]"
            >
                <span>Explorer le catalogue matériel</span>
                <span>→</span>
            </a>
        </div>
    {% else %}
        <!-- Comparison Table Container -->
        <div class="overflow-x-auto pb-6">
            <div class="min-w-[760px] lg:min-w-full">
                <!-- En-tête des produits (Cards) -->
                <div class="grid grid-cols-{{ products|length + 1 }} gap-4 mb-6 items-stretch">
                    <!-- Colonne Métriques / Libellés -->
                    <div class="p-4 rounded-2xl bg-[#0B0D13] border border-white/5 flex flex-col justify-end">
                        <span class="text-xs font-mono text-cyan-400 uppercase tracking-wider">Matériel sélectionné</span>
                        <p class="text-lg font-bold text-white mt-1">{{ products|length }} / 3 produits</p>
                        <p class="text-xs text-neutral-500 mt-2">Dakar Express : livraison sous 24h ouvrées.</p>
                    </div>

                    <!-- Colonnes Produits -->
                    {% for product in products %}
                        <div class="relative p-5 rounded-2xl bg-[#12151E] border border-white/10 flex flex-col justify-between group hover:border-cyan-500/40 transition">
                            <!-- Bouton retirer -->
                            <button
                                type="button"
                                data-action="click->comparison#remove"
                                data-comparison-id-param="{{ product.id }}"
                                class="absolute top-3 right-3 w-7 h-7 rounded-full bg-neutral-900/80 hover:bg-red-500/80 text-neutral-400 hover:text-white flex items-center justify-center text-sm border border-white/10 transition z-10"
                                title="Retirer du comparatif"
                            >
                                ×
                            </button>

                            <div>
                                <!-- Image produit -->
                                <a href="{{ path('app_product_show', {slug: product.slug}) }}" class="block overflow-hidden rounded-xl bg-neutral-950 border border-white/5 mb-4 aspect-video flex items-center justify-center p-2">
                                    {% if product.imageFilename %}
                                        <img
                                            src="{{ asset('images/products/' ~ product.imageFilename) }}"
                                            alt="{{ product.name }}"
                                            class="h-full w-full object-contain group-hover:scale-105 transition-transform duration-300"
                                        >
                                    {% else %}
                                        <span class="text-3xl text-neutral-600">⚡</span>
                                    {% endif %}
                                </a>

                                <!-- Badges Condition & Marque -->
                                <div class="flex items-center gap-2 mb-2 flex-wrap">
                                    <span class="text-[11px] font-mono px-2 py-0.5 rounded-full {{ product.condition.badgeClasses }}">
                                        {{ product.condition.label }}
                                    </span>
                                    <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-neutral-800 text-neutral-300">
                                        {{ product.brand }}
                                    </span>
                                </div>

                                <!-- Titre -->
                                <h3 class="font-bold text-white text-base leading-snug mb-2 line-clamp-2">
                                    <a href="{{ path('app_product_show', {slug: product.slug}) }}" class="hover:text-cyan-400 transition">
                                        {{ product.name }}
                                    </a>
                                </h3>

                                <!-- Prix XOF -->
                                <div class="mb-3">
                                    <span class="text-xl font-mono font-bold text-orange-400">
                                        {{ product.price|number_format(0, ',', ' ') }} XOF
                                    </span>
                                    {% if product.oldPrice and product.oldPrice > product.price %}
                                        <span class="text-xs font-mono text-neutral-500 line-through ml-2">
                                            {{ product.oldPrice|number_format(0, ',', ' ') }} XOF
                                        </span>
                                    {% endif %}
                                </div>
                            </div>

                            <!-- Actions CTAs -->
                            <div class="pt-3 border-t border-white/10 flex flex-col gap-2">
                                <a
                                    href="{{ path('app_product_show', {slug: product.slug}) }}"
                                    class="w-full text-center py-2 px-3 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-black font-semibold text-xs transition shadow-[0_0_15px_rgba(6,182,212,0.25)]"
                                >
                                    Voir la fiche & commander
                                </a>
                            </div>
                        </div>
                    {% endfor %}
                </div>

                <!-- Section Disponibilité & Fiabilité -->
                <div class="mb-6 rounded-2xl bg-[#0D0F17] border border-white/10 overflow-hidden">
                    <div class="bg-white/5 px-4 py-2.5 text-xs font-mono uppercase tracking-wider text-neutral-300 font-semibold border-b border-white/10">
                        Disponibilité & Garanties
                    </div>

                    <!-- Disponibilité Stock -->
                    <div class="grid grid-cols-{{ products|length + 1 }} border-b border-white/5 py-3 px-4 text-xs">
                        <div class="font-medium text-neutral-400">Stock & Disponibilité</div>
                        {% for product in products %}
                            <div>
                                {% if product.stock > 0 %}
                                    <span class="inline-flex items-center gap-1.5 text-emerald-400 font-mono">
                                        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                                        En stock ({{ product.stock }} unités)
                                    </span>
                                {% else %}
                                    <span class="inline-flex items-center gap-1.5 text-red-400 font-mono">
                                        <span class="w-2 h-2 rounded-full bg-red-400"></span>
                                        Rupture temporaire
                                    </span>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>

                    <!-- Garantie -->
                    <div class="grid grid-cols-{{ products|length + 1 }} border-b border-white/5 py-3 px-4 text-xs">
                        <div class="font-medium text-neutral-400">Garantie certifiée</div>
                        {% for product in products %}
                            <div class="font-mono text-neutral-200">
                                {{ product.warrantyMonths }} mois atelier & pièces
                            </div>
                        {% endfor %}
                    </div>

                    <!-- Référence SKU -->
                    <div class="grid grid-cols-{{ products|length + 1 }} py-3 px-4 text-xs">
                        <div class="font-medium text-neutral-400">Référence SKU</div>
                        {% for product in products %}
                            <div class="font-mono text-neutral-400 text-[11px]">
                                {{ product.sku|default('SKU-TL-' ~ product.id) }}
                            </div>
                        {% endfor %}
                    </div>
                </div>

                <!-- Section Spécifications Techniques Détaillées -->
                <div class="rounded-2xl bg-[#0D0F17] border border-white/10 overflow-hidden">
                    <div class="bg-white/5 px-4 py-2.5 text-xs font-mono uppercase tracking-wider text-cyan-400 font-semibold border-b border-white/10 flex items-center justify-between">
                        <span>Spécifications Matérielles Détaillées</span>
                        <span class="text-[10px] text-neutral-400">Différences surlignées</span>
                    </div>

                    {% if specKeys is empty %}
                        <div class="p-6 text-center text-xs text-neutral-500 font-mono">
                            Aucune spécification JSON renseignée pour ces produits.
                        </div>
                    {% else %}
                        {% for key in specKeys %}
                            {% set firstVal = products[0].specifications[key]|default(null) %}
                            {% set hasDiff = false %}
                            {% for p in products %}
                                {% if p.specifications[key]|default(null) != firstVal %}
                                    {% set hasDiff = true %}
                                {% endif %}
                            {% endfor %}

                            <div class="grid grid-cols-{{ products|length + 1 }} border-b border-white/5 py-3 px-4 text-xs items-center {{ hasDiff ? 'bg-cyan-950/20' : '' }}">
                                <div class="font-medium text-neutral-300 flex items-center gap-1.5">
                                    <span>{{ key }}</span>
                                    {% if hasDiff %}
                                        <span class="w-1.5 h-1.5 rounded-full bg-cyan-400" title="Valeurs différentes entre les produits"></span>
                                    {% endif %}
                                </div>
                                {% for product in products %}
                                    <div class="font-mono {{ hasDiff ? 'text-cyan-200 font-medium' : 'text-neutral-400' }}">
                                        {{ product.specifications[key]|default('—') }}
                                    </div>
                                {% endfor %}
                            </div>
                        {% endfor %}
                    {% endif %}
                </div>
            </div>
        </div>
    {% endif %}
</section>
{% endblock %}
