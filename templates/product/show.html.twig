{% extends 'base.html.twig' %}

{% block title %}{{ product.name }} — <span class="text-neutral-500">&lt;/</span>techlink<span class="text-neutral-500">&gt;</span>{% endblock %}

{% block meta_description %}{{ product.description|slice(0, 155)|striptags|trim ~ '...' }}{% endblock %}

{% block og_image %}
    {%- if product.imageFilename -%}
        {{ absolute_url(asset('images/products/' ~ product.imageFilename)) }}
    {%- endif -%}
{% endblock %}

{% block body %}
{% for message in app.flashes('success') %}
    <div class="max-w-7xl mx-auto px-6 pt-6">
        <div class="bg-green-500/10 border border-green-500 text-green-500 text-sm rounded-xl px-4 py-3">
            {{ message }}
        </div>
    </div>
{% endfor %}
{% for message in app.flashes('error') %}
    <div class="max-w-7xl mx-auto px-6 pt-6">
        <div class="bg-red-500/10 border border-red-500 text-red-500 text-sm rounded-xl px-4 py-3">
            {{ message }}
        </div>
    </div>
{% endfor %}

    <section class="max-w-7xl mx-auto px-6 py-12 grid grid-cols-1 md:grid-cols-2 gap-12">
        <div class="self-start" data-controller="product-gallery">
            {% if product.imageFilename %}
                <div class="overflow-hidden rounded-2xl bg-neutral-900 mb-4">
                    <img
                        data-product-gallery-target="mainImage"
                        src="{{ asset('images/products/' ~ product.imageFilename) }}"
                        alt="{{ product.name }}"
                        class="h-96 w-full object-cover opacity-0"
                        onload="this.classList.remove('opacity-0')"
                    >
                </div>
            {% else %}
                <div class="bg-neutral-900 rounded-2xl h-96 animate-pulse mb-4"></div>
            {% endif %}

            {% if product.productImages|length > 0 %}
                <div class="flex gap-3">
                    {% if product.imageFilename %}
                        <button
                            type="button"
                            data-action="click->product-gallery#change"
                            data-image="{{ asset('images/products/' ~ product.imageFilename) }}"
                            class="w-16 h-16 rounded-lg overflow-hidden border-2 border-orange-500 flex-shrink-0"
                        >
                            <img src="{{ asset('images/products/' ~ product.imageFilename) }}" class="w-full h-full object-cover">
                        </button>
                    {% endif %}
                    {% for image in product.productImages|sort((a, b) => a.position <=> b.position) %}
                        <button
                            type="button"
                            data-action="click->product-gallery#change"
                            data-image="{{ asset('images/products/' ~ image.filename) }}"
                            class="w-16 h-16 rounded-lg overflow-hidden border-2 border-transparent hover:border-orange-500 flex-shrink-0 transition"
                        >
                            <img src="{{ asset('images/products/' ~ image.filename) }}" class="w-full h-full object-cover">
                        </button>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        <div>
            <p class="text-neutral-500 text-sm mb-2">{{ product.brand }}</p>
            <h1 class="text-3xl font-bold mb-4">{{ product.name }}</h1>
            
            <div class="flex items-center justify-between mb-6">
                <p class="text-orange-500 text-3xl font-bold">{{ product.price|number_format(0, ',', ' ') }} XOF</p>

                <button
                    type="button"
                    data-controller="wishlist-toggle"
                    data-wishlist-toggle-url-value="{{ path('app_wishlist_toggle', {id: product.id}) }}"
                    data-action="click->wishlist-toggle#toggle"
                    class="flex items-center gap-2 text-sm text-neutral-400 hover:text-orange-500 transition"
                >
                    <span data-wishlist-toggle-target="icon" class="text-xl {{ isInWishlist|default(false) ? 'text-orange-500' : '' }}">{{ isInWishlist|default(false) ? '♥' : '♡' }}</span>
                    <span class="hidden sm:inline">Ajouter aux favoris</span>
                </button>
            </div>

            <p class="text-neutral-400 mb-8">{{ product.description }}</p>

            {% if product.specifications is not empty %}
            <div class="mb-8 border border-neutral-800 rounded-2xl overflow-hidden">
                <p class="text-xs text-neutral-500 uppercase tracking-widest font-semibold px-5 py-3 border-b border-neutral-800 bg-neutral-900/50">
                    🔧 Fiche technique
                </p>
                <dl class="divide-y divide-neutral-800/60">
                    {% for key, value in product.specifications %}
                    <div class="flex flex-col sm:flex-row sm:items-start px-5 py-3 text-sm hover:bg-neutral-900/30 transition-colors gap-1 sm:gap-4">
                        <dt class="sm:w-2/5 text-neutral-500 shrink-0">{{ key }}</dt>
                        <dd class="sm:w-3/5 font-medium text-white">{{ value }}</dd>
                    </div>
                    {% endfor %}
                </dl>
            </div>
            {% endif %}

            <div class="flex flex-wrap gap-3 sm:gap-4 text-xs text-neutral-400 mb-8">
                <span class="border border-neutral-800 rounded-full px-3 py-1">Livraison 24h</span>
                <span class="border border-neutral-800 rounded-full px-3 py-1">Garantie incluse</span>
                <span class="border border-neutral-800 rounded-full px-3 py-1">Wave / Orange Money</span>
            </div>

            <p class="text-sm mb-6">
                {% if product.stock > 0 %}
                    <span class="text-green-500">En stock</span> ({{ product.stock }} disponibles)
                {% else %}
                    <span class="text-red-500">Rupture de stock</span>
                {% endif %}
            </p>

                <form method="post" action="{{ path('app_cart_add', {id: product.id}) }}" data-controller="add-to-cart-toast">
                    <div class="mb-6">
                        <p class="text-sm text-neutral-400 mb-3">Quantité</p>
                        <div class="flex items-center gap-3 w-fit border border-neutral-700 rounded-full px-2 py-1">
                            <button type="button" onclick="this.nextElementSibling.stepDown()" class="w-8 h-8 flex items-center justify-center hover:text-orange-500 transition text-lg">−</button>
                            <input type="number" name="quantity" value="1" min="1" max="{{ product.stock }}" class="w-12 text-center bg-transparent focus:outline-none">
                            <button type="button" onclick="this.previousElementSibling.stepUp()" class="w-8 h-8 flex items-center justify-center hover:text-orange-500 transition text-lg">+</button>
                        </div>
                    </div>
                    {% if product.productColors|length > 0 %}
                    <div class="mb-6">
                        <p class="text-sm text-neutral-400 mb-3">Couleur</p>
                        <div class="flex gap-2 flex-wrap">
                            {% set hasAvailableColor = false %}
                            {% for color in product.productColors %}
                                <label class="{{ color.stock > 0 ? 'cursor-pointer' : 'cursor-not-allowed opacity-50' }}" title="{{ color.stock > 0 ? '' : 'Rupture de stock' }}">
                                    <input type="radio" name="color" value="{{ color.name }}" class="peer hidden" {% if color.stock > 0 and not hasAvailableColor %}checked{% set hasAvailableColor = true %}{% endif %} {% if color.stock <= 0 %}disabled{% endif %}>
                                    <span class="flex items-center gap-2 px-4 py-2 rounded-full border border-neutral-700 text-sm peer-checked:border-orange-500 peer-checked:text-orange-500 transition">
                                        {% if color.hexCode %}
                                            <span class="w-3 h-3 rounded-full border border-neutral-600" style="background-color: {{ color.hexCode }};"></span>
                                        {% endif %}
                                        {{ color.name }}
                                        {% if color.stock <= 0 %}
                                            <span class="text-[10px] ml-1">(Rupture)</span>
                                        {% endif %}
                                    </span>
                                </label>
                            {% endfor %}
                        </div>
                    </div>
                    {% endif %}
                    <button
                        type="submit"
                        class="bg-white text-black font-semibold px-8 py-3 rounded-full hover:bg-orange-500 transition-all duration-300 w-full md:w-auto"
                    >
                        Ajouter au panier
                    </button>
                </form>

            <a href="https://wa.me/221773956966?text={{ ('Bonjour, je souhaite commander : ' ~ product.name ~ ' - ' ~ product.price|number_format(0, '', '') ~ ' XOF - ' ~ app.request.schemeAndHttpHost ~ path('app_product_show', {slug: product.slug}))|url_encode }}" target="_blank" rel="noopener" class="mt-3 flex items-center justify-center gap-2 bg-green-500 hover:bg-green-600 text-white font-semibold px-8 py-3 rounded-full transition-all duration-300 w-full md:w-auto">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
                    <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21 5.46 0 9.91-4.45 9.91-9.91C21.95 6.45 17.5 2 12.04 2zm5.71 14.16c-.24.68-1.4 1.31-1.93 1.36-.53.05-1.02.25-3.44-.72-2.91-1.16-4.78-4.13-4.92-4.32-.14-.19-1.18-1.57-1.18-3 0-1.42.75-2.12 1.02-2.41.27-.29.58-.36.78-.36.19 0 .39 0 .56.01.18.01.42-.07.66.5.24.58.83 2 .9 2.15.07.15.12.32.02.51-.1.19-.15.31-.29.48-.15.17-.31.38-.44.51-.15.15-.3.31-.13.6.17.29.75 1.24 1.62 2.01 1.11.99 2.05 1.3 2.34 1.44.29.15.46.13.63-.08.17-.2.72-.84.91-1.13.19-.29.38-.24.64-.14.26.1 1.65.78 1.94.92.29.14.48.22.55.34.07.12.07.7-.17 1.38z"/>
                </svg>
                Commander via WhatsApp
            </a>
        </div>
    </section>

    <section class="max-w-7xl mx-auto px-6 pb-16">
        <h2 class="text-2xl font-bold mb-2">Avis clients</h2>
        <p class="text-neutral-400 mb-8">
            {% if averageRating > 0 %}
                ⭐ {{ averageRating }}/5 — {{ product.reviews|length }} avis
            {% else %}
                Aucun avis pour l'instant
            {% endif %}
        </p>

        {% if app.user and canReview %}
            <form method="post" action="{{ path('app_product_review', {slug: product.slug}) }}" class="border border-neutral-800 rounded-2xl p-6 mb-8 flex flex-col gap-4">
                <div>
                    <p class="text-sm text-neutral-400 mb-2">Ta note</p>
                    <div class="flex gap-2">
                        {% for i in 1..5 %}
                            <label for="rating-{{ i }}">
                                <input type="radio" id="rating-{{ i }}" name="rating" value="{{ i }}" class="peer hidden" required>
                                <span class="text-2xl cursor-pointer grayscale peer-checked:grayscale-0 transition">⭐</span>
                            </label>
                        {% endfor %}
                    </div>
                </div>
                <textarea name="comment" rows="3" required placeholder="Partage ton expérience avec ce produit..." class="w-full bg-neutral-900 border border-neutral-700 rounded-2xl px-4 py-3 text-sm focus:outline-none focus:border-orange-500"></textarea>
                <button type="submit" class="bg-white text-black font-semibold px-6 py-2.5 rounded-full hover:bg-orange-500 transition w-fit">
                    Publier mon avis
                </button>
            </form>
        {% endif %}

       <div class="flex flex-col gap-4">
    {% for review in reviews %}
        <div class="border border-neutral-800 rounded-2xl p-6">
            <div class="flex items-center justify-between mb-2">
                <p class="font-semibold">{{ review.user.firstName }}</p>
                <p class="text-orange-500">
                    {% for i in 1..review.rating %}⭐{% endfor %}
                </p>
            </div>
            {% if review.isVerified %}
                <span class="text-xs text-green-500 bg-green-500/10 px-2 py-0.5 rounded-full">✔ Achat vérifié</span>
            {% endif %}
            <p class="text-neutral-400 text-sm mt-3">{{ review.comment }}</p>
            {% if app.user and review.user == app.user %}
                <form method="post" action="{{ path('app_review_delete', {id: review.id}) }}" class="mt-3">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_review_' ~ review.id) }}">
                    <button type="submit" class="text-xs text-red-500 hover:underline" onclick="return confirm('Supprimer ton avis ?')">
                        Supprimer mon avis
                    </button>
                </form>
            {% endif %}
        </div>
    {% else %}
        <p class="text-neutral-500 text-sm">Sois le premier à laisser un avis sur ce produit.</p>
    {% endfor %}
</div>

{% if totalReviewPages > 1 %}
    <div class="flex items-center justify-center gap-2 mt-8">
        {% for i in 1..totalReviewPages %}
            <a href="{{ path('app_product_show', {slug: product.slug}) }}?avis_page={{ i }}#avis" class="w-9 h-9 flex items-center justify-center rounded-full text-sm transition {{ i == reviewsPage ? 'bg-orange-500 text-black font-semibold' : 'border border-neutral-800 hover:border-orange-500 hover:text-orange-500' }}">
                {{ i }}
            </a>
        {% endfor %}
    </div>
{% endif %}
    </section>
{% endblock %}