{% extends 'base.html.twig' %}

{% block title %}Catalogue — TechLink{% endblock %}

{% block meta_description %}
    {%- if selectedCategories|length > 0 -%}
        Découvrez notre sélection de {{ selectedCategories[0].name }} et plus chez TechLink. Matériel de qualité et livraison rapide sous 24h à Dakar.
    {%- elseif selectedBrands|length > 0 -%}
        Découvrez nos produits des marques {{ selectedBrands|join(', ') }} chez TechLink. Les meilleurs composants au meilleur prix à Dakar.
    {%- else -%}
        Explorez tout notre catalogue d'ordinateurs, smartphones et composants informatiques de qualité chez TechLink. Livraison sous 24h à Dakar.
    {%- endif -%}
{% endblock %}

{% block body %}
    <section class="max-w-7xl mx-auto px-6 py-12">

        <div class="flex items-center justify-between mb-8 reveal reveal-delay-100">
            <h1 class="text-3xl font-bold">
                {% if selectedCategories|length == 1 %}
                    {{ selectedCategories[0].name }}
                {% elseif selectedCategories|length > 1 %}
                    Produits filtrés ({{ selectedCategories|length }} catégories)
                {% else %}
                    Tous nos produits
                {% endif %}
                
                {% if selectedBrands|length == 1 %}
                    — {{ selectedBrands[0] }}
                {% elseif selectedBrands|length > 1 %}
                    — {{ selectedBrands|length }} marques
                {% endif %}
            </h1>
            <p class="text-neutral-500 text-sm">{{ products|length }} résultat{{ products|length > 1 ? 's' : '' }}</p>
        </div>

        {% if products is empty %}
            <div class="flex flex-col items-center justify-center py-24 text-center">
                <div class="text-6xl mb-4">📦</div>
                <h2 class="text-xl font-bold mb-2">Aucun produit trouvé</h2>
                <p class="text-neutral-500 mb-6 max-w-sm">
                    Aucun produit ne correspond à ta recherche pour le moment. Essaie un autre filtre ou reviens plus tard.
                </p>
                <a href="{{ path('app_product_index') }}" class="bg-white text-black font-semibold px-6 py-3 rounded-full hover:bg-orange-500 transition">
                    Voir tous les produits
                </a>
            </div>
        {% else %}
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-6" data-controller="reveal">
                {% for product in products %}
                    <a href="{{ path('app_product_show', {slug: product.slug}) }}" class="relative border border-neutral-800 rounded-2xl p-4 product-card-3d block group reveal reveal-delay-{{ loop.index0 * 50 > 500 ? 500 : loop.index0 * 50 }}">
                        {% if product.oldPrice and product.oldPrice > product.price %}
                            {% set discount = ((product.oldPrice - product.price) / product.oldPrice * 100)|round %}
                            <span class="absolute top-3 left-3 z-10 bg-orange-500 text-black text-xs font-bold px-2.5 py-1 rounded-full shadow-lg">
                                -{{ discount }}%
                            </span>
                        {% endif %}

                        <button
                            type="button"
                            data-controller="wishlist-toggle"
                            data-wishlist-toggle-url-value="{{ path('app_wishlist_toggle', {id: product.id}) }}"
                            data-action="click->wishlist-toggle#toggle"
                            class="absolute top-3 right-3 z-20 w-8 h-8 flex items-center justify-center rounded-full bg-neutral-900/80 backdrop-blur-sm border border-neutral-700 hover:border-orange-500 transition group/wishlist"
                        >
                            <span data-wishlist-toggle-target="icon" class="text-lg {{ product.id in wishlistProductIds|default([]) ? 'text-orange-500' : 'text-neutral-400 group-hover/wishlist:text-orange-500' }} transition">
                                {{ product.id in wishlistProductIds|default([]) ? '♥' : '♡' }}
                            </span>
                        </button>

                        {% if product.imageFilename %}
                            <div class="overflow-hidden rounded-xl mb-4 bg-neutral-900 image-zoom-hover">
                                <img
                                    src="{{ asset('images/products/' ~ product.imageFilename) }}"
                                    alt="{{ product.name }}"
                                    loading="lazy"
                                    class="h-40 w-full object-cover opacity-0 transition-opacity duration-300"
                                    onload="this.classList.remove('opacity-0')"
                                >
                            </div>
                        {% else %}
                            <div class="bg-neutral-900 rounded-xl h-40 mb-4 animate-pulse"></div>
                        {% endif %}

                        <p class="text-xs text-neutral-500">{{ product.brand }}</p>
                        <p class="font-semibold">{{ product.name }}</p>
                        <div class="flex items-center gap-2 mt-2">
                            <p class="text-orange-500 font-bold">{{ product.price|number_format(0, ',', ' ') }} XOF</p>
                            {% if product.oldPrice and product.oldPrice > product.price %}
                                <p class="text-neutral-500 text-xs line-through">{{ product.oldPrice|number_format(0, ',', ' ') }} XOF</p>
                            {% endif %}
                        </div>
                        <p class="text-xs text-neutral-500 mt-1">
                            {% if product.stock > 0 %}
                                En stock ({{ product.stock }})
                            {% else %}
                                Rupture de stock
                            {% endif %}
                        </p>
                    </a>
                {% endfor %}
            </div>

            {% if totalPages > 1 %}
                <div class="flex items-center justify-center gap-2 mt-12">
                    {% if currentPage > 1 %}
                        <a href="{{ path('app_product_index', app.request.query.all|merge({page: currentPage - 1})) }}" class="px-4 py-2 rounded-full border border-neutral-800 text-sm hover:border-orange-500 hover:text-orange-500 transition">
                            ← Précédent
                        </a>
                    {% endif %}

                    {% for i in 1..totalPages %}
                        <a href="{{ path('app_product_index', app.request.query.all|merge({page: i})) }}" class="w-10 h-10 flex items-center justify-center rounded-full text-sm transition {{ i == currentPage ? 'bg-orange-500 text-black font-semibold' : 'border border-neutral-800 hover:border-orange-500 hover:text-orange-500' }}">
                            {{ i }}
                        </a>
                    {% endfor %}

                    {% if currentPage < totalPages %}
                        <a href="{{ path('app_product_index', app.request.query.all|merge({page: currentPage + 1})) }}" class="px-4 py-2 rounded-full border border-neutral-800 text-sm hover:border-orange-500 hover:text-orange-500 transition">
                            Suivant →
                        </a>
                    {% endif %}
                </div>
            {% endif %}
        {% endif %}
    </section>
{% endblock %}