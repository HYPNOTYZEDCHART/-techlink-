<!DOCTYPE html>
<html lang="fr" data-turbo="true">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}<span class="text-neutral-500">&lt;/</span>techlink<span class="text-neutral-500">&gt;</span> Boutique{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text></svg>">
        
        <!-- SEO Meta Tags -->
        <meta name="description" content="{% block meta_description %}techLink Boutique - Laptops, smartphones et accessoires de qualité pro, livrés en 24h à Dakar (Sénégal).{% endblock %}">
        <meta name="robots" content="{% block meta_robots %}index, follow{% endblock %}">
        <meta name="view-transition" content="same-origin" />
        
        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website">
        <meta property="og:url" content="{% block og_url %}{{ app.request.uri }}{% endblock %}">
        <meta property="og:title" content="{% block og_title %}{{ block('title')|striptags }}{% endblock %}">
        <meta property="og:description" content="{% block og_description %}{{ block('meta_description')|striptags }}{% endblock %}">
        {% set og_image_val %}
            {% block og_image %}{% endblock %}
        {% endset %}
        {% set og_image_val = og_image_val|trim %}
        {% if og_image_val is not empty %}
        <meta property="og:image" content="{{ og_image_val }}">
        {% endif %}
        
        <!-- Twitter -->
        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:url" content="{{ block('og_url') }}">
        <meta name="twitter:title" content="{{ block('og_title') }}">
        <meta name="twitter:description" content="{{ block('og_description') }}">
        {% if og_image_val is not empty %}
        <meta name="twitter:image" content="{{ og_image_val }}">
        {% endif %}
        
        <!-- Canonical URL -->
        <link rel="canonical" href="{{ block('og_url') }}">
        
        <link rel="preconnect" href="https://fonts.googleapis.com">
     <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
     <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
            <link rel="stylesheet" href="{{ asset('styles/custom.css') }}">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="bg-black text-white antialiased overflow-x-hidden">
       {% include 'components/_announcement_bar.html.twig' %}
        {% include 'components/_header.html.twig' %}

        <main>
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="fixed top-20 right-4 z-50 bg-neutral-900 border border-neutral-700 text-white px-6 py-4 rounded-xl shadow-2xl flex items-start gap-4 transform transition-all duration-300 translate-x-full animate-slide-in" data-controller="flash">
                        {% if label == 'success' %}
                            <div class="bg-green-500/20 text-green-500 p-2 rounded-full">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                            </div>
                        {% elseif label == 'error' %}
                            <div class="bg-red-500/20 text-red-500 p-2 rounded-full">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                            </div>
                        {% else %}
                            <div class="bg-blue-500/20 text-blue-500 p-2 rounded-full">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            </div>
                        {% endif %}
                        <div class="flex-1 mt-1">
                            <p class="text-sm font-medium">{{ message }}</p>
                        </div>
                        <button type="button" class="text-neutral-500 hover:text-white" onclick="this.parentElement.remove()">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                        </button>
                    </div>
                {% endfor %}
            {% endfor %}
            {% block body %}{% endblock %}
        </main>
        {% include 'components/_whatsapp_button.html.twig' %}
        {% include 'components/_footer.html.twig' %}
    </body>
</html>