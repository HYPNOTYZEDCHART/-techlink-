<header class="sticky top-0 z-50 bg-black border-b border-neutral-800 transition-all duration-300" data-controller="header-scroll" data-header-scroll-target="header">
    <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between gap-6 transition-all duration-300">
        <a href="{{ path('app_home') }}" class="text-2xl font-bold tracking-tight">
    <span class="text-neutral-500">&lt;/</span><span class="text-orange-500">tech</span>link<span class="text-neutral-500">&gt;</span>
</a>

        <div class="hidden md:flex flex-1 max-w-xl relative" data-controller="search-suggestions">
    <form action="{{ path('app_product_index') }}" method="get" class="w-full">
        <input
            type="text"
            name="recherche"
            placeholder="Rechercher un laptop, un smartphone..."
            autocomplete="off"
            data-search-suggestions-target="input"
            data-action="input->search-suggestions#search"
            class="w-full bg-neutral-900 border border-neutral-700 rounded-full px-5 py-2.5 text-sm focus:outline-none focus:border-orange-500"
        >
    </form>

    <div
        data-search-suggestions-target="results"
        class="hidden absolute left-0 top-full mt-2 w-full bg-neutral-950 border border-neutral-800 rounded-2xl shadow-xl overflow-hidden z-50 max-h-96 overflow-y-auto"
    ></div>
</div>
        <div class="flex items-center gap-4">
    <span class="hidden lg:flex items-center gap-2 text-xs text-neutral-500 border border-neutral-800 rounded-full px-3 py-1.5">
        💳 Wave / Orange Money
    </span>

    {% if app.user %}
        <div class="hidden md:flex items-center gap-4">
            <a href="{{ path('app_account') }}" class="text-sm hover:text-orange-500 transition">
                Bonjour {{ app.user.firstName }}
            </a>
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('admin') }}" class="text-sm text-orange-500 hover:underline">Admin</a>
            {% endif %}
            <a href="{{ path('app_logout') }}" class="text-sm text-neutral-400 hover:text-orange-500 transition">Déconnexion</a>
        </div>
        <!-- Icône compte sur mobile -->
        <a href="{{ path('app_account') }}" class="md:hidden text-xl hover:text-orange-500 transition">
            👤
        </a>
    {% else %}
        <a href="{{ path('app_login') }}" class="text-sm hover:text-orange-500 transition hidden md:block">Mon compte</a>
        <!-- Icône compte sur mobile -->
        <a href="{{ path('app_login') }}" class="md:hidden text-xl hover:text-orange-500 transition">
            👤
        </a>
    {% endif %}

    <a href="{{ path('app_wishlist') }}" class="relative hover:text-orange-500 transition text-xl md:text-base mr-2">
        ♥
        <span data-wishlist-count class="absolute -top-2 -right-2 bg-orange-500 text-black text-xs font-bold w-4 h-4 md:w-5 md:h-5 rounded-full flex items-center justify-center">{{ wishlist_count() }}</span>
    </a>

    <a href="{{ path('app_cart') }}" class="relative hover:text-orange-500 transition text-xl md:text-base">
        🛒
        <span data-cart-count class="absolute -top-2 -right-2 bg-orange-500 text-black text-xs font-bold w-4 h-4 md:w-5 md:h-5 rounded-full flex items-center justify-center">{{ cart_count() }}</span>
    </a>
</div>
    </div>

    <div class="md:hidden px-6 pb-3 relative" data-controller="search-suggestions">
        <form action="{{ path('app_product_index') }}" method="get">
            <input
                type="text"
                name="recherche"
                placeholder="Rechercher..."
                autocomplete="off"
                data-search-suggestions-target="input"
                data-action="input->search-suggestions#search"
                class="w-full bg-neutral-900 border border-neutral-700 rounded-full px-5 py-2.5 text-sm focus:outline-none focus:border-orange-500"
            >
        </form>
        <div
            data-search-suggestions-target="results"
            class="hidden absolute left-6 right-6 mt-2 bg-neutral-950 border border-neutral-800 rounded-2xl shadow-xl overflow-hidden z-50 max-h-96 overflow-y-auto"
        ></div>
    </div>

    <nav class="border-t border-neutral-800">
        <div class="max-w-7xl mx-auto px-6 flex items-center gap-4 md:gap-8 text-sm">
            <details class="relative py-3">
                <summary class="cursor-pointer whitespace-nowrap hover:text-orange-500 transition list-none flex items-center gap-2 font-semibold">
                    ☰ <span class="hidden md:inline">Toutes les catégories</span><span class="md:hidden">Menu</span>
                </summary>
                <form action="{{ path('app_product_index') }}" method="get">
                    <div class="absolute left-0 top-full mt-1 bg-neutral-950 border border-neutral-800 rounded-xl shadow-xl p-6 z-50 flex flex-col md:grid md:grid-cols-3 gap-8" style="width: 800px; max-width: 90vw;">
                        <div>
                            <p class="text-xs text-neutral-500 uppercase tracking-wide mb-4 font-semibold">Catégorie</p>
                            <div class="flex flex-col gap-3 max-h-64 overflow-y-auto custom-scrollbar pr-2">
                                {% for category in all_categories() %}
                                    <label class="flex items-center gap-3 cursor-pointer group">
                                        <input type="checkbox" name="categorie[]" value="{{ category.slug }}" class="w-4 h-4 rounded border-neutral-700 bg-neutral-900 text-orange-500 focus:ring-orange-500 focus:ring-offset-neutral-950 cursor-pointer">
                                        <span class="text-sm text-neutral-300 group-hover:text-white transition">{{ category.name }}</span>
                                    </label>
                                {% endfor %}
                            </div>
                        </div>
                        <div>
                            <p class="text-xs text-neutral-500 uppercase tracking-wide mb-4 font-semibold">Marque</p>
                            <div class="flex flex-col gap-3 max-h-64 overflow-y-auto custom-scrollbar pr-2">
                                {% for brand in all_brands() %}
                                    <label class="flex items-center gap-3 cursor-pointer group">
                                        <input type="checkbox" name="marque[]" value="{{ brand }}" class="w-4 h-4 rounded border-neutral-700 bg-neutral-900 text-orange-500 focus:ring-orange-500 focus:ring-offset-neutral-950 cursor-pointer">
                                        <span class="text-sm text-neutral-300 group-hover:text-white transition">{{ brand }}</span>
                                    </label>
                                {% endfor %}
                            </div>
                        </div>
                        <div>
                            <p class="text-xs text-neutral-500 uppercase tracking-wide mb-4 font-semibold">Prix (XOF)</p>
                            <div class="flex flex-col gap-4">
                                <div class="grid grid-cols-2 gap-2">
                                    <input type="number" name="prix_min" placeholder="Min" class="w-full bg-neutral-900 border border-neutral-700 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-orange-500">
                                    <input type="number" name="prix_max" placeholder="Max" class="w-full bg-neutral-900 border border-neutral-700 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-orange-500">
                                </div>
                                <button type="submit" class="w-full bg-orange-500 text-black text-sm font-bold px-4 py-3 rounded-lg hover:bg-orange-400 transition mt-2 shadow-lg shadow-orange-500/20">
                                    Appliquer les filtres
                                </button>
                                <button type="reset" onclick="window.location.href='{{ path('app_product_index') }}'" class="w-full bg-transparent text-neutral-400 hover:text-white text-xs py-1 transition">
                                    Effacer les filtres
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </details>

            <div class="flex items-center gap-4 md:gap-8 overflow-x-auto pb-1 scrollbar-hide">
                {% for category in all_categories() %}
                    <a href="{{ path('app_product_index', {categorie: category.slug}) }}" class="py-3 whitespace-nowrap hover:text-orange-500 transition">
                        {{ category.name }}
                    </a>
                {% endfor %}
                <a href="{{ path('app_product_index') }}?promo=1" class="py-3 whitespace-nowrap text-orange-500 font-semibold hover:text-orange-400 transition flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
                    Promos
                </a>
            </div>
        </div>
    </nav>
</header>