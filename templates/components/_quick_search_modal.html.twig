<div
    id="quick-search-modal"
    data-controller="quick-search"
    data-quick-search-target="modal"
    class="hidden fixed inset-0 z-50 overflow-y-auto"
    role="dialog"
    aria-modal="true"
    aria-label="Recherche rapide de produits"
>
    <!-- Backdrop flou sombre -->
    <div
        data-quick-search-target="backdrop"
        data-action="click->quick-search#onBackdropClick"
        class="fixed inset-0 bg-black/80 backdrop-blur-md transition-opacity duration-300"
    ></div>

    <div class="min-h-screen px-4 text-center flex items-start justify-center pt-16 md:pt-24 pb-6">
        <!-- Modal Container Cyber-Clean -->
        <div class="relative inline-block w-full max-w-2xl text-left align-middle transition-all transform bg-[#12151E] border border-white/10 rounded-3xl shadow-2xl overflow-hidden z-10">
            <!-- Search Input Bar -->
            <div class="relative flex items-center px-5 py-4 border-b border-white/10 bg-[#090A0F]">
                <svg class="w-5 h-5 text-neutral-400 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>

                <input
                    type="text"
                    data-quick-search-target="input"
                    data-action="input->quick-search#onInput"
                    placeholder="Rechercher par nom, marque, processeur, SKU... (ex: M3, S24, OLED)"
                    class="w-full bg-transparent text-white placeholder-neutral-500 text-base focus:outline-none font-sans"
                    autocomplete="off"
                    spellcheck="false"
                >

                <!-- Spinner -->
                <div data-quick-search-target="spinner" class="hidden mr-3">
                    <svg class="animate-spin h-5 w-5 text-orange-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                    </svg>
                </div>

                <!-- Close ESC Badge -->
                <button
                    type="button"
                    data-action="click->quick-search#close"
                    class="px-2 py-1 bg-white/5 border border-white/10 rounded-lg text-neutral-400 text-xs font-mono hover:text-white hover:border-white/20 transition"
                >
                    ESC
                </button>
            </div>

            <!-- Dynamic Results Container -->
            <div data-quick-search-target="results" class="hidden"></div>

            <!-- Default Placeholder / Quick Links -->
            <div data-quick-search-target="placeholder" class="p-6">
                <p class="text-xs font-mono uppercase tracking-wider text-neutral-500 mb-3">Recherches rapides</p>
                <div class="flex flex-wrap gap-2 mb-6">
                    <button
                        type="button"
                        onclick="const input = document.querySelector('[data-quick-search-target=input]'); input.value = 'Apple'; input.dispatchEvent(new Event('input'))"
                        class="px-3 py-1.5 rounded-full bg-white/5 hover:bg-orange-500/10 hover:text-orange-400 border border-white/10 text-xs text-neutral-300 transition"
                    >
                        🍎 Apple
                    </button>
                    <button
                        type="button"
                        onclick="const input = document.querySelector('[data-quick-search-target=input]'); input.value = 'Samsung'; input.dispatchEvent(new Event('input'))"
                        class="px-3 py-1.5 rounded-full bg-white/5 hover:bg-orange-500/10 hover:text-orange-400 border border-white/10 text-xs text-neutral-300 transition"
                    >
                        📱 Samsung Galaxy
                    </button>
                    <button
                        type="button"
                        onclick="const input = document.querySelector('[data-quick-search-target=input]'); input.value = 'MacBook Pro'; input.dispatchEvent(new Event('input'))"
                        class="px-3 py-1.5 rounded-full bg-white/5 hover:bg-orange-500/10 hover:text-orange-400 border border-white/10 text-xs text-neutral-300 transition"
                    >
                        💻 MacBook M3
                    </button>
                    <button
                        type="button"
                        onclick="const input = document.querySelector('[data-quick-search-target=input]'); input.value = 'Dell XPS'; input.dispatchEvent(new Event('input'))"
                        class="px-3 py-1.5 rounded-full bg-white/5 hover:bg-orange-500/10 hover:text-orange-400 border border-white/10 text-xs text-neutral-300 transition"
                    >
                        ⚡ Dell XPS
                    </button>
                    <button
                        type="button"
                        onclick="const input = document.querySelector('[data-quick-search-target=input]'); input.value = 'Sony'; input.dispatchEvent(new Event('input'))"
                        class="px-3 py-1.5 rounded-full bg-white/5 hover:bg-orange-500/10 hover:text-orange-400 border border-white/10 text-xs text-neutral-300 transition"
                    >
                        🎧 Sony Audio
                    </button>
                </div>

                <div class="border-t border-white/5 pt-4 flex items-center justify-between text-xs text-neutral-500 font-mono">
                    <span>TechLink Live Catalog</span>
                    <span>Raccourci global : <kbd class="px-1.5 py-0.5 bg-white/10 rounded text-neutral-300">Ctrl + K</kbd></span>
                </div>
            </div>
        </div>
    </div>
</div>
