{# templates/components/_comparison_bar.html.twig #}
<aside
    id="comparison-floating-bar"
    data-controller="comparison"
    data-comparison-state-url-value="{{ path('app_product_compare_state') }}"
    data-comparison-add-url-value="/comparateur/ajouter"
    data-comparison-remove-url-value="/comparateur/retirer"
    data-comparison-clear-url-value="{{ path('app_product_compare_clear') }}"
    data-comparison-compare-url-value="{{ path('app_product_compare') }}"
    data-comparison-target="bar"
    class="fixed bottom-5 left-1/2 -translate-x-1/2 z-40 w-[95%] max-w-3xl bg-[#0E121B]/95 backdrop-blur-xl border border-cyan-500/20 rounded-2xl p-3 md:p-4 shadow-[0_20px_50px_rgba(0,0,0,0.85)] transition-all duration-300 transform translate-y-36 opacity-0 pointer-events-none"
    role="region"
    aria-label="Barre de comparaison de matériel"
>
    <div class="flex items-center justify-between gap-3 md:gap-4">
        <!-- En-tête info & Compteur -->
        <div class="flex items-center gap-3 shrink-0">
            <div class="w-8 h-8 rounded-lg bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                </svg>
            </div>
            <div class="hidden sm:block">
                <p class="text-xs font-semibold text-white tracking-wide uppercase">Comparateur</p>
                <p class="text-[11px] text-neutral-400 font-mono"><span data-comparison-target="countText">0</span> / 3 sélectionnés</p>
            </div>
        </div>

        <!-- 3 Slots de produits -->
        <div class="flex items-center gap-2 flex-1 justify-center max-w-md overflow-x-auto" data-comparison-target="slotsContainer">
            <!-- Rendu dynamique par Stimulus -->
        </div>

        <!-- Boutons d'action -->
        <div class="flex items-center gap-2 shrink-0">
            <button
                type="button"
                data-action="click->comparison#clear"
                class="px-2.5 py-2 text-xs text-neutral-400 hover:text-neutral-200 hover:bg-white/5 rounded-xl transition"
                title="Vider la sélection"
            >
                Vider
            </button>
            <a
                href="{{ path('app_product_compare') }}"
                data-comparison-target="compareBtn"
                class="inline-flex items-center gap-1.5 px-4 py-2 bg-cyan-500 hover:bg-cyan-400 text-black font-semibold text-xs md:text-sm rounded-xl shadow-[0_0_20px_rgba(6,182,212,0.35)] transition"
            >
                <span>Comparer</span>
                <span data-comparison-target="compareCountBadge" class="px-1.5 py-0.2 bg-black/20 rounded font-mono text-[11px]">0</span>
                <span>→</span>
            </a>
        </div>
    </div>
</aside>
