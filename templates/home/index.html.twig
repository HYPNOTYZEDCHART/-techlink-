{% extends 'base.html.twig' %}

{% block title %}<span class="text-neutral-500">&lt;/</span>techlink<span class="text-neutral-500">&gt;</span> — La tech pro, livrée vite à Dakar{% endblock %}

{% block body %}
    <section class="relative py-32 px-6 overflow-hidden flex items-center min-h-[80vh] bg-neutral-900">
        <!-- Vidéo en arrière-plan -->
        <video 
            autoplay 
            loop 
            muted 
            playsinline 
            class="absolute inset-0 w-full h-full object-cover z-0"
        >
            <source src="{{ asset('videos/hero-tech.mp4') }}" type="video/mp4">
        </video>
        <!-- Overlays -->
        <div class="absolute inset-0 z-0 bg-black/30 pointer-events-none"></div>
        <div class="absolute inset-0 z-0 bg-gradient-to-r from-black/90 via-black/50 to-transparent pointer-events-none"></div>

        <div class="max-w-7xl mx-auto relative z-10 w-full reveal">
            <span class="inline-block bg-neutral-900/80 border border-neutral-700 backdrop-blur-md text-orange-500 text-xs font-medium px-4 py-1.5 rounded-full mb-6 reveal reveal-delay-100 shadow-xl">
                <span class="animate-pulse inline-block mr-1">●</span> Stock mis à jour en temps réel
            </span>
            <h1 class="text-5xl md:text-7xl font-bold leading-tight max-w-4xl reveal reveal-delay-200 drop-shadow-2xl">
                La tech pro, livrée <br/>
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-orange-600 italic">demain</span> à Dakar.
            </h1>
            <p class="text-neutral-300 mt-6 text-lg max-w-xl reveal reveal-delay-300 drop-shadow-md">
                Laptops, smartphones, composants. Les meilleures marques mondiales, au prix juste, avec un SAV local.
            </p>
            <div class="flex gap-4 mt-10 reveal reveal-delay-400">
                <a href="{{ path('app_product_index') }}" class="bg-white text-black font-semibold px-8 py-4 rounded-full hover:bg-orange-500 hover:text-white transition-colors duration-300 btn-premium shadow-2xl">
                    Explorer le catalogue →
                </a>
            </div>
        </div>
    </section>

    <section class="max-w-7xl mx-auto px-6 py-16 grid grid-cols-1 md:grid-cols-3 gap-6 text-center" data-controller="reveal">
        <div class="border border-neutral-800 rounded-2xl p-6 reveal reveal-delay-100">
            <p class="text-orange-500 font-semibold mb-1">🚚 Livraison 24h</p>
            <p class="text-neutral-400 text-sm">Livré le lendemain partout à Dakar</p>
        </div>
        <div class="border border-neutral-800 rounded-2xl p-6 reveal reveal-delay-200">
            <p class="text-orange-500 font-semibold mb-1">💳 Wave & Orange Money</p>
            <p class="text-neutral-400 text-sm">Paiement mobile local accepté</p>
        </div>
        <div class="border border-neutral-800 rounded-2xl p-6 reveal reveal-delay-300">
            <p class="text-orange-500 font-semibold mb-1">🛡️ Garantie 6-12 mois</p>
            <p class="text-neutral-400 text-sm">Selon le produit acheté</p>
        </div>
    </section>

    <section class="max-w-7xl mx-auto px-6 py-16">
        <h2 class="text-2xl font-bold mb-8">Nouveautés</h2>

        {% if featuredProducts is empty %}
            <div class="flex flex-col items-center justify-center py-16 text-center border border-neutral-800 rounded-2xl">
                <div class="text-5xl mb-4">🛍️</div>
                <p class="text-neutral-400">Les premiers produits arrivent très bientôt — reviens vite !</p>
            </div>
        {% else %}
            <div class="grid grid-cols-2 md:grid-cols-4 gap-6" data-controller="reveal">
                {% for product in featuredProducts %}
                    <a href="{{ path('app_product_show', {slug: product.slug}) }}" class="relative border border-neutral-800 rounded-2xl p-4 product-card-3d block group reveal reveal-delay-{{ loop.index0 * 100 > 500 ? 500 : loop.index0 * 100 }}">
                        {% if product.oldPrice and product.oldPrice > product.price %}
                            {% set discount = ((product.oldPrice - product.price) / product.oldPrice * 100)|round %}
                            <span class="absolute top-3 left-3 z-10 bg-orange-500 text-black text-xs font-bold px-2.5 py-1 rounded-full shadow-lg">
                                -{{ discount }}%
                            </span>
                        {% endif %}

                        <button
                            type="button"
                            data-controller="wishlist-toggle"
                            data-wishlist-toggle-url-value="{{ path('app_wishlist_toggle', {id: product.id}) }}"
                            data-wishlist-toggle-token-value="{{ csrf_token('wishlist_toggle_' ~ product.id) }}"
                            data-action="click->wishlist-toggle#toggle"
                            class="absolute top-3 right-3 z-20 w-8 h-8 flex items-center justify-center rounded-full bg-neutral-900/80 backdrop-blur-sm border border-neutral-700 hover:border-orange-500 transition group/wishlist"
                        >
                            <span data-wishlist-toggle-target="icon" class="text-lg {{ product.id in wishlistProductIds|default([]) ? 'text-orange-500' : 'text-neutral-400 group-hover/wishlist:text-orange-500' }} transition">
                                {{ product.id in wishlistProductIds|default([]) ? '♥' : '♡' }}
                            </span>
                        </button>

                        {% if product.imageFilename %}
                            <div class="overflow-hidden rounded-xl mb-4 bg-neutral-900 image-zoom-hover">
                                <img
                                    src="{{ asset('images/products/' ~ product.imageFilename) }}"
                                    alt="{{ product.name }}"
                                    loading="lazy"
                                    class="h-40 w-full object-cover opacity-0 transition-opacity duration-300"
                                    onload="this.classList.remove('opacity-0')"
                                >
                            </div>
                        {% else %}
                            <div class="bg-neutral-900 rounded-xl h-40 mb-4 animate-pulse"></div>
                        {% endif %}

                        <p class="text-xs text-neutral-500">{{ product.brand }}</p>
                        <p class="font-semibold">{{ product.name }}</p>
                        <div class="flex items-center gap-2 mt-2">
                            <p class="text-orange-500 font-bold">{{ product.price|number_format(0, ',', ' ') }} XOF</p>
                            {% if product.oldPrice and product.oldPrice > product.price %}
                                <p class="text-neutral-500 text-xs line-through">{{ product.oldPrice|number_format(0, ',', ' ') }} XOF</p>
                            {% endif %}
                        </div>
                    </a>
                {% endfor %}
            </div>
        {% endif %}
    </section>
{% endblock %}